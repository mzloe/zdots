# Written to /usr/share/sddm/themes/ze/current/theme.conf by `ze theme set`,
# which appends Background= / BackgroundVideo= for the login wallpaper.
[General]
Font="JetBrainsMono Nerd Font"
FontSize="12"
RoundCorners="12"
HourFormat="HH:mm"
DateFormat="dddd d MMMM"
Text="{{ foreground }}"
TextMuted="{{ light_foreground }}"
Accent="{{ accent }}"
FormBackground="{{ background }}"
FieldBackground="{{ lighter_background }}"
Placeholder="{{ muted }}"
Warning="{{ red }}"
Dropdown="{{ lighter_background }}"
DropdownSelected="{{ selection }}"
